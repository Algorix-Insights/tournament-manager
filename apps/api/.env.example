# Environment Variables for Tournament Manager API

# Database Connection (Prisma & MySQL)
DATABASE_URL="mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@localhost:${MYSQL_PORT}/${MYSQL_DATABASE}"
DATABASE_PROD_URL="change-me"
DATABASE_COMPOSE_URL="mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@localhost:${MYSQL_PORT}/${MYSQL_DATABASE}"

# Server Configuration
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# MySQL (Docker Compose)
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=tournament_db
MYSQL_USER=tournament
MYSQL_PASSWORD=change-me
MYSQL_PORT=3306
