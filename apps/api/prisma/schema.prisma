// Prisma Schema para el Sistema de Torneo de Videojuegos
// Base de datos: MySQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Jugador {
  id            Int          @id @default(autoincrement())
  nombre        String       @db.VarChar(100)
  gamertag      String       @unique @db.VarChar(50)
  correo        String       @db.VarChar(100)
  fechaRegistro DateTime     @default(now()) @map("fecha_registro")
  puntuaciones  Puntuacion[]

  @@map("jugadores")
}

model Videojuego {
  id           Int          @id @default(autoincrement())
  nombre       String       @unique @db.VarChar(100)
  genero       String       @db.VarChar(50)
  puntuaciones Puntuacion[]

  @@map("videojuegos")
}

model Puntuacion {
  id           Int        @id @default(autoincrement())
  jugadorId    Int        @map("jugador_id")
  videojuegoId Int        @map("videojuego_id")
  puntuacion   Int
  fecha        DateTime   @default(now())

  jugador    Jugador    @relation(fields: [jugadorId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  videojuego Videojuego @relation(fields: [videojuegoId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("puntuaciones")
}
