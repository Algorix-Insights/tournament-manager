// Prisma Schema for Video Game Tournament System
// Database: MySQL

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "mysql"
}

model Player {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  gamertag  String   @unique @db.VarChar(50)
  email     String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  scores    Score[]

  @@map("players")
}

model Genre {
  id    Int    @id @default(autoincrement())
  name  String @unique @db.VarChar(50)
  games Game[]
  @@map("genres")
}

model Game {
  id      Int     @id @default(autoincrement())
  name    String  @unique @db.VarChar(100)
  genreId Int     @map("genre_id")
  genre   Genre   @relation(fields: [genreId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  scores  Score[]

  @@map("games")
}

model Score {
  id        Int      @id @default(autoincrement())
  playerId  Int      @map("player_id")
  gameId    Int      @map("game_id")
  score     Int
  createdAt DateTime @default(now()) @map("created_at")

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("scores")
}
